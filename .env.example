# 앱 런타임용 (역할: app_user, Neon 풀러 주소 권장)
DATABASE_URL=postgres://app_user:CHANGE_ME@HOST/neondb?sslmode=require
# 마이그레이션·인증용 (소유자 역할)
DATABASE_URL_OWNER=postgres://OWNER:CHANGE_ME@HOST/neondb?sslmode=require
# 마이그레이션이 app_user 역할을 만들 때 쓰는 비밀번호 (DATABASE_URL의 비밀번호와 같아야 함)
APP_DB_PASSWORD=CHANGE_ME

BETTER_AUTH_SECRET=32자_이상_랜덤_문자열
BETTER_AUTH_URL=http://localhost:3000

# ollama(개발) 또는 anthropic(운영)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# 비전 가능한 Ollama 모델이 있을 때만 설정 (없으면 이미지 입력은 막힘)
OLLAMA_VISION_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# 사용자당 일일 호출 상한
DAILY_CALL_LIMIT=50
