# 앱 런타임용 (역할: app_user, Neon 풀러 주소 권장)
DATABASE_URL=postgres://app_user:CHANGE_ME@HOST/neondb?sslmode=require
# 인증 모듈용 (역할: auth_user, 인증 테이블 4개만 접근)
DATABASE_URL_AUTH=postgres://auth_user:CHANGE_ME@HOST/neondb?sslmode=require
# 마이그레이션 전용 (소유자 역할). 앱 런타임에서는 쓰지 않는다
DATABASE_URL_OWNER=postgres://OWNER:CHANGE_ME@HOST/neondb?sslmode=require
# 마이그레이션이 역할을 만들 때 쓰는 비밀번호 (각 연결 문자열의 비밀번호와 같아야 함)
APP_DB_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME

BETTER_AUTH_SECRET=32자_이상_랜덤_문자열
BETTER_AUTH_URL=http://localhost:3000

# 메일 발송 (비밀번호 재설정·이메일 확인). 비워 두면 개발 환경에서는 콘솔에 링크를 출력한다
RESEND_API_KEY=
MAIL_FROM=Ledgie <no-reply@example.com>
# 메일 발송을 설정한 뒤 true로 켜면 이메일 확인 전에는 로그인할 수 없다
REQUIRE_EMAIL_VERIFICATION=false

# ollama(개발) 또는 anthropic(운영)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# 비전 가능한 Ollama 모델이 있을 때만 설정 (없으면 이미지 입력은 막힘)
OLLAMA_VISION_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# 사용자당 하루(한국 날짜 기준) 호출 상한
DAILY_CALL_LIMIT=50
